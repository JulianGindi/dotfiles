	name = Julian Gindi
	email = jgindi@riotgames.com
[core]
	editor = /opt/homebrew/bin/nvim
	excludesfile = /Users/julian/dotfiles/git/Python.gitignore
[grep]
  linenumber = true
[color]
	ui = auto
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = false
[gpg]
	program = gpg
[init]
	defaultBranch = main
[diff]
	tool = bc
[difftool "bc"]
	trustExitCode = true
